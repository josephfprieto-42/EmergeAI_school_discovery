# Copy to backend/.env and fill in. Never commit backend/.env.

# OpenAI (server-side only). Leave blank to run with deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Maps JavaScript API key. This key is sent to the browser via GET /api/config,
# so restrict it in Google Cloud Console to HTTP referrers http://localhost:5173/* and
# API = Maps JavaScript API only.
GOOGLE_MAPS_BROWSER_KEY=

# Google Geocoding API key (server-side only; never exposed). If blank, falls back to
# GOOGLE_MAPS_BROWSER_KEY, and if that is also blank, to an offline ZIP/neighborhood lookup.
GOOGLE_GEOCODING_KEY=

# Optional: a Map ID from Google Cloud for Advanced Markers / custom styling.
GOOGLE_MAP_ID=

# Allowed browser origins for the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
